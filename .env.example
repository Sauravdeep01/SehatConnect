# SehatConnect Environment Variables Example
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL Database Configuration
DB_NAME=sehatconnect_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
